FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        curl \
        git \
        make \
        openssh-client \
        rsync \
        sshpass \
        sudo \
    && rm -rf /var/lib/apt/lists/*

# Pin mitogen to 0.3.41: 0.3.48 introduced a UnifiedTaskResult regression
# that causes "argument of type 'UnifiedTaskResult' is not iterable" in
# all Ansible modes (not just --check). Local env uses 0.3.41 which works.
RUN pip install --no-cache-dir \
    ansible-core \
    ansible-lint \
    cryptography \
    docker \
    jmespath \
    "mitogen==0.3.41" \
    passlib \
    pyyaml \
    redis \
    requests

WORKDIR /workspace
